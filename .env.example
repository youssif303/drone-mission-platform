# ReconEye Environment Configuration Example

# Demo Mode (Simulate drone telemetry and video feeds when hardware/simulators are offline)
DEMO_MODE=true

# Database Connection (Async SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./recon_eye.db

# Host and Port Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
